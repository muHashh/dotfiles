  },
  "editor.tokenColorCustomizations": {
    "[Dark Modern]": {
      "textMateRules": [
        {
          "scope": [
            "comment",
            "punctuation.definition.comment"
          ],
          "name": "Comment",
          "settings": {
            "fontStyle": "italic",
            "foreground": "#738091"
          }
        },
        {
          "scope": [
            "string",
            "string.quoted",
            "string.template"
          ],
          "name": "String",
          "settings": {
            "foreground": "#81b29a"
          }
        },
        {
          "scope": [
            "string.regexp"
          ],
          "name": "Regexp",
          "settings": {
            "foreground": "#e0c989"
          }
        },
        {
          "scope": [
            "constant.numeric",
            "constant.language.numeric"
          ],
          "name": "Number",
          "settings": {
            "foreground": "#f4a261"
          }
        },
        {
          "scope": [
            "constant",
            "constant.language",
            "constant.character.escape"
          ],
          "name": "Constant",
          "settings": {
            "foreground": "#f6b079"
          }
        },
        {
          "scope": [
            "variable",
            "variable.other.readwrite",
            "variable.parameter"
          ],
          "name": "Variable",
          "settings": {
            "foreground": "#dfdfe0"
          }
        },
        {
          "scope": [
            "variable.other.property",
            "variable.other.object.property"
          ],
          "name": "Variable Property",
          "settings": {
            "foreground": "#719cd6"
          }
        },
        {
          "scope": [
            "keyword",
            "keyword.control",
            "storage.type",
            "storage.modifier"
          ],
          "name": "Keyword",
          "settings": {
            "foreground": "#9d79d6"
          }
        },
        {
          "scope": [
            "keyword.operator"
          ],
          "name": "Operator",
          "settings": {
            "foreground": "#aeafb0"
          }
        },
        {
          "scope": [
            "keyword.control.conditional",
            "keyword.control.loop"
          ],
          "name": "Conditional",
          "settings": {
            "foreground": "#baa1e2"
          }
        },
        {
          "scope": [
            "entity.name.function",
            "support.function",
            "meta.function-call"
          ],
          "name": "Function",
          "settings": {
            "foreground": "#86abdc"
          }
        },
        {
          "scope": [
            "entity.name.type",
            "support.type",
            "support.class"
          ],
          "name": "Type",
          "settings": {
            "foreground": "#dbc074"
          }
        },
        {
          "scope": [
            "entity.name.class",
            "entity.name.type.class",
            "support.class"
          ],
          "name": "Class",
          "settings": {
            "foreground": "#dbc074"
          }
        },
        {
          "scope": [
            "support.type.primitive",
            "support.type.builtin"
          ],
          "name": "Builtin Type",
          "settings": {
            "foreground": "#7ad5d6"
          }
        },
        {
          "scope": [
            "variable.language",
            "variable.language.this",
            "variable.language.super"
          ],
          "name": "Builtin Variable",
          "settings": {
            "foreground": "#c94f6d"
          }
        },
        {
          "scope": [
            "constant.language",
            "support.constant"
          ],
          "name": "Builtin Constant",
          "settings": {
            "foreground": "#f6b079"
          }
        },
        {
          "scope": [
            "variable.other.constant",
            "variable.other.enummember"
          ],
          "name": "Identifier",
          "settings": {
            "foreground": "#63cdcf"
          }
        },
        {
          "scope": [
            "meta.preprocessor",
            "entity.name.function.preprocessor"
          ],
          "name": "Preprocessor",
          "settings": {
            "foreground": "#dc8ed9"
          }
        },
        {
          "scope": [
            "entity.name.tag",
            "meta.tag"
          ],
          "name": "Tag",
          "settings": {
            "foreground": "#9d79d6"
          }
        },
        {
          "scope": [
            "entity.other.attribute-name"
          ],
          "name": "Tag Attribute",
          "settings": {
            "foreground": "#719cd6"
          }
        },
        {
          "scope": [
            "punctuation.definition.tag",
            "punctuation.section",
            "punctuation.separator",
            "punctuation.terminator"
          ],
          "name": "Brackets",
          "settings": {
            "foreground": "#aeafb0"
          }
        },
        {
          "scope": [
            "invalid.deprecated"
          ],
          "name": "Deprecated",
          "settings": {
            "fontStyle": "strikethrough",
            "foreground": "#71839b"
          }
        },
        {
          "scope": [
            "invalid",
            "invalid.illegal"
          ],
          "name": "Invalid",
          "settings": {
            "foreground": "#c94f6d"
          }
        },
        {
          "scope": [
            "markup.heading",
            "entity.name.section"
          ],
          "name": "Markdown Heading",
          "settings": {
            "fontStyle": "bold",
            "foreground": "#86abdc"
          }
        },
        {
          "scope": [
            "markup.bold"
          ],
          "name": "Markdown Bold",
          "settings": {
            "fontStyle": "bold",
            "foreground": "#9d79d6"
          }
        },
        {
          "scope": [
            "markup.italic"
          ],
          "name": "Markdown Italic",
          "settings": {
            "fontStyle": "italic",
            "foreground": "#9d79d6"
          }
        },
        {
          "scope": [
            "markup.inline.raw",
            "markup.fenced_code"
          ],
          "name": "Markdown Code",
          "settings": {
            "foreground": "#81b29a"
          }
        },
        {
          "scope": [
            "markup.underline.link"
          ],
          "name": "Markdown Link",
          "settings": {
            "foreground": "#63cdcf"
          }
        },
        {
          "scope": [
            "markup.quote"
          ],
          "name": "Markdown Quote",
          "settings": {
            "fontStyle": "italic",
            "foreground": "#738091"
          }
        }
      ]
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "[Dark Modern]": {
      "rules": {
        "namespace": "#63cdcf",
        "class": "#dbc074",
        "enum": "#dbc074",
        "interface": "#dbc074",
        "struct": "#dbc074",
        "typeParameter": "#dbc074",
        "module": "#63cdcf",
        "method": "#86abdc",
        "function.defaultLibrary": "#86abdc",
        "method.defaultLibrary": "#86abdc",
        "parameter": "#dfdfe0",
        "property": "#719cd6",
        "enumMember": "#f6b079",
        "variable.readonly": "#f6b079",
        "property.readonly": "#f6b079",
        "variable.defaultLibrary": "#c94f6d",
        "modifier": "#9d79d6",
        "comment.documentation": "#738091",
        "regexp": "#e0c989",
        "macro": "#dc8ed9",
        "*.deprecated": "#71839b",
        "*.modification": "#dbc074",
        "*.declaration": {
          "bold": true
        },
        "keyword": "#9d79d6",
        "struct.go": "#dbc074",
        "interface.go": "#dbc074",
        "variable": "#dfdfe0",
        "function.go": "#86abdc",
        "variable.go": "#dfdfe0",
        "parameter.go": "#dfdfe0",
        "property.go": "#719cd6",
        "namespace.go": "#63cdcf",
        "function": "#86abdc",
        "method.go": "#86abdc",
        "type.go": "#dbc074",
        "type.defaultLibrary": "#7ad5d6",
        "type": "#dbc074",
        "operator": "#aeafb0",
        "comment": "#738091",
        "string": "#81b29a",
        "number": "#f4a261"
      }
    }
  }
}