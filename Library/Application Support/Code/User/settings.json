{
  "workbench.startupEditor": "none",
  "editor.minimap.enabled": false,
  "[python]": {
    "editor.formatOnType": true
  },
  "go.toolsManagement.autoUpdate": true,
  "python.defaultInterpreterPath": "/usr/local/bin/python3",
  // "clangd.path": "/Users/hassan/Library/Application Support/Code/User/globalStorage/llvm-vs-code-extensions.vscode-clangd/install/16.0.2/clangd_16.0.2/bin/clangd",
  "files.exclude": {},
  "files.watcherExclude": {},
  "editor.fontLigatures": true,
  "git.openRepositoryInParentFolders": "always",
  // "C_Cpp.intelliSenseEngine": "disabled",
  // "[cpp]": {
  //   "editor.wordBasedSuggestions": false,
  //   "editor.suggest.insertMode": "replace",
  //   "editor.semanticHighlighting.enabled": true
  // },
  // "C_Cpp.intelliSenseEngineFallback": "enabled",
  // "editor.cursorSmoothCaretAnimation": "on",
  "terminal.integrated.fontSize": 12,
  // "terminal.integrated.fontWeight": "bold",
  "editor.fontSize": 12,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "telemetry.telemetryLevel": "off",
  "gitlens.telemetry.enabled": false,
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "vim.smartRelativeLine": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  // "editor.fontWeight": "bold",
  "leetcode.workspaceFolder": "/Users/hassan/.leetcode",
  "cmake.pinnedCommands": [
    "workbench.action.tasks.configureTaskRunner",
    "workbench.action.tasks.runTask"
  ],
  "supermaven.enableFixWithSupermaven": true,
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "explorer.confirmDelete": false,
  "C_Cpp.clang_format_fallbackStyle": "Google",
  "supermaven.otherWarning": false,
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "github.copilot.selectedCompletionModel": "",
  "leetcode.hint.configWebviewMarkdown": false,
  "leetcode.hint.commandShortcut": false,
  "leetcode.defaultLanguage": "cpp",
  "tabnine.experimentalAutoImports": true,
  "continue.enableTabAutocomplete": false,
  "editor.lineNumbers": "on",
  "everforest.darkWorkbench": "high-contrast",
  "editor.wordWrap": "off",
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "json": false
  },
  "kilo-code.allowedCommands": [
    "npm test",
    "npm install",
    "tsc",
    "git log",
    "git diff",
    "git show"
  ],
  "kilo-code.deniedCommands": [],
  "github.copilot.advanced": {},
  "workbench.activityBar.location": "top",
  // "workbench.editor.showTabs": "none",
  "workbench.editor.enablePreview": false,
  "window.commandCenter": false,
  "breadcrumbs.enabled": false,
  "editor.padding.top": 10,
  "workbench.statusBar.visible": true,
  "workbench.colorTheme": "Terafox",
  "chatgpt.followUpQueueMode": "steer",
  //
