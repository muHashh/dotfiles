      "activityBarBadge.foreground": "#131a24",
      "statusBar.foreground": "#aeafb0",
      "statusBar.debuggingForeground": "#131a24",
      "panelTitle.activeForeground": "#cdcecf",
      "panelTitle.inactiveForeground": "#71839b",
      "terminal.foreground": "#cdcecf",
